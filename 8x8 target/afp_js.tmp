var isBtnEnabled=true;function displayError(a){enableContinueButton()}function hideErrors(){$("login-not-allowed","login-failed","no-tenant-name","unknown-error","relogin","ext-error","exceed_max_login").invoke("hide")}function forgotPassword(){if(isBtnEnabled){disableContinueButton();var a="";var c=$j("#uName").val();var b=c.split("@");if(b[1]!=""&&b[1]!=null&&b[1]!=undefined){$("tenant").value=b[1];$("admin").value=b[0];a="../GEN/gen_check_redirection.php?tenant="+encodeURIComponent($("tenant").value)+"&admin="+$("admin").value}else{$("tenant").value=c;a="../GEN/gen_check_redirection.php?tenant="+encodeURIComponent($("tenant").value)}$j.ajax({url:a}).done(function(e,f,d){checkTenantResponse(d)}).fail(function(d,f,e){displayError("unknown-error")})}}function checkTenantResponse(c){var d=$j.parseXML(c.responseText);var b=$j(d);var a=b.find("tenantType").text();var f=b.find("redirectURL").text();if(a=="VOVCC"&&f){var e={};e[usernameParam]=b.find(usernameParam).text();e[tenantNameParam]=b.find(tenantNameParam).text();e[redirectedParam]=b.find(redirectedParam).text();e[helpParam]=b.find(helpParam).text();common.redirectTo8x8SSO(f,e)}else{if(f!=null&&f.length>0){f+="CM/admin_forgot_password.php";var g=$F("query_string");if(g!=null&&g.length>0){g="?"+g}else{g=""}document.forgot_pass.action=f+g}document.forgot_pass.reset.value="reset";document.forgot_pass.submit()}}function disableContinueButton(){document.getElementById("continue_button").disabled=true;isBtnEnabled=false}function enableContinueButton(){document.getElementById("continue_button").disabled=false;isBtnEnabled=true};