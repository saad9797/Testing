(function(a){var c=a.login={};var d={};c.REMEMBER_ME_TOKEN_NAME="cmRememberMeToken";const b=new URLSearchParams(window.location.search);c.init=function(){sessionStorage.setItem("displayHybridWarning","yes");if(!$j.isEmptyObject(c.redirect8x8SSO)){var e={};e[c.tenantNameParam]=c.redirect8x8SSO.tenantId;e[c.redirectedParam]=c.redirect8x8SSO.redirected;e[c.ssoUsernameParam]=c.redirect8x8SSO.username;e[c.ssoMsgParam]=c.ssoMsgValue;common.redirectTo8x8SSO(c.redirect8x8SSO.URL,e)}if(b.get("error")==="1"){c.displayError("unknown-error")}if(!c.tryLoginUsingToken()){$j(document.body).show();if(!c.checkBrowserVersion()){$j("#user").focus().select()}}};c.submit=function(){if(!$j("#action-login").hasClass("disabled")){c.hideErrors();c.disableButton();$j("#user").val($j("#user").val().replace(/\s*$/,"").replace(/^\s*/,""));$j("#pass").val($j("#pass").val().replace(/\s*$/,""));try{var k=document.URL;var f=k.split("?");var n="?";if(f.length==2){var g=f[1].split("&");for(var j=0;j<g.length;j++){var l=g[j].split("=")[0];if(l=="lang"||l=="oem"){n=n+"&"+g[j]}}var o=document.loginform.action;document.loginform.action=o+n}}catch(m){}var h=c.formatUserName($j("#tenant").val(),$j("#user").val());var e="../GEN/gen_check_tenant_admin.php?type=cm_login&admin="+encodeURIComponent(h);$j.ajax({url:e}).done(function(p,q,i){c.checkTenantResponse(i)}).fail(function(i,q,p){c.displayError("unknown-error")})}};c.displayError=function(e){$j("#"+e).show();$j("#pass").val("");$j("#user").focus();$j("#user").select();c.enableButton()};c.hideErrors=function(){$j("#alert-wrapper").children().hide()};c.disableButton=function(){$j("#action-login").addClass("disabled")};c.enableButton=function(){$j("#action-login").removeClass("disabled")};c.forgetPassword=function(){c.forgetPasswordWin=window.open("admin_forgot_password.php?"+$j("#query_string").val(),"ResetPassword","width=800, height=583 ,top=100, left=100, scrollbars=1");c.forgetPasswordWin.focus();return false};c.formatUserName=function(f,e){var g="";if(